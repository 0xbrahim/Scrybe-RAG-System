    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "gemma3:4b"
            },
            {
              "name": "prompt",
              "value": "={{ \"You are a document question-answering assistant.\\n\\nAnswer the user's question using ONLY the information contained in the provided document context.\\n\\nIf the answer cannot be found in the context, say that the information was not found in the document. Do not invent information.\\n\\nDOCUMENT CONTEXT:\\n\" + $json.context + \"\\n\\nUSER QUESTION:\\n\" + $json.question + \"\\n\\nANSWER:\" }}"
            },
            {
              "name": "stream",
              "value": "={{ false }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        864,
        0
      ],
      "id": "a61a41c2-43dd-491d-b4e6-484e01a0fdf3",
      "name": "Generate Answer - Gemma"
    },
    {
      "parameters": {
        "jsCode": "const chunks = $input.all();\n\nconst context = chunks\n  .map((item, index) => {\n    return `--- Document Chunk ${index + 1} ---\\n${item.json.content}`;\n  })\n  .join('\\n\\n');\n\nreturn [\n  {\n    json: {\n      context: context,\n      question: $('Webhook').first().json.body.question,\n      document_id: $('Webhook').first().json.body.document_id\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        0
      ],
      "id": "f85306a1-323f-446f-a522-cae9c78e606e",
      "name": "Build Context"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"answer\": $json.response } }}",
        "options": {}
      },
