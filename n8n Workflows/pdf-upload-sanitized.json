      "id": "369c274c-a153-4793-8bf7-72427edd7c3b",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "const text =\n    $('Extract from File').first().json.text;\n\nconst documentId =\n    $('Generate Document ID').first().json.document_id;\n\nconst filename =\n    $('Generate Document ID').first().json.filename;\n\nconst chunkSize = 4000;\nconst overlap = 500;\n\nconst chunks = [];\n\nlet start = 0;\n\nwhile (start < text.length) {\n\n    const end = Math.min(\n        start + chunkSize,\n        text.length\n    );\n\n    const chunk = text.substring(start, end);\n\n    chunks.push({\n        json: {\n            text: chunk,\n            document_id: documentId,\n            filename: filename\n        }\n    });\n\n    start += chunkSize - overlap;\n}\n\nreturn chunks;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
