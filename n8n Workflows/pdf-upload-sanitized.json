    },
    {
      "parameters": {
        "jsCode": "const embeddings = $input.all();\n\nconst chunks = $('Code in JavaScript').all();\n\nreturn embeddings.map((item, index) => {\n    return {\n        json: {\n            text: chunks[index].json.text,\n            embedding: item.json.embeddings[0],\n            document_id: chunks[index].json.document_id,\n            filename: chunks[index].json.filename\n        }\n    };\n});"
      },
