        "jsCode": "const documentId =\n    Date.now().toString() + \"-\" +\n    Math.random().toString(36).substring(2, 10);\n\nconst fileName =\n    $('Webhook').first().binary.file.fileName;\n\nreturn [{\n    json: {\n        document_id: documentId,\n        filename: fileName\n    }\n}];"
